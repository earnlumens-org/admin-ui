# Cloudflare Pages security headers — admin-ui (single-host admin panel).
#
# Served as-is by Cloudflare Pages from the build output root.
# Authoritative source of CSP / HSTS / framing for admin.earnlumens.org;
# meta tags inside index.html are a defence-in-depth fallback only.
#
# Differences vs media-store-ui:
#  - No GTM / no analytics → strict 'self' on script-src (no 'unsafe-inline').
#  - API is cross-origin (api.admin.earnlumens.org), so connect-src must
#    whitelist it explicitly. Horizon is allowed because admin-ui validates
#    Stellar account existence client-side (services/stellar.ts).
#  - 'unsafe-inline' on style-src is required by Vuetify.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.earnlumens.org https://cdn-dev.earnlumens.org https://pbs.twimg.com https://abs.twimg.com; media-src 'self' blob: https://cdn.earnlumens.org https://cdn-dev.earnlumens.org; font-src 'self' data:; connect-src 'self' https://api.admin.earnlumens.org https://api.admin-dev.earnlumens.org https://cdn.earnlumens.org https://cdn-dev.earnlumens.org https://horizon.stellar.org https://horizon-testnet.stellar.org; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
